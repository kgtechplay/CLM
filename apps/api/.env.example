APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
Admin_Password=
ADMIN_TOKEN_TTL_SECONDS=28800

# Supabase values are server-only. Do not copy secret keys into apps/web.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# URL-encode special characters in the password. % becomes %25, ? becomes %3F, @ becomes %40.
DATABASE_URL=
DATABASE_DIRECT_URL=

# Set true to use the LLM by default. The chat UI can still opt in per session
# when OPENAI_API_KEY is present.
LLM_ENABLED=false
LLM_MODERATION_ENABLED=true

# Provider details are read only on the server. Do not put these in the web app.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TIMEOUT_SECONDS=20
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=280
